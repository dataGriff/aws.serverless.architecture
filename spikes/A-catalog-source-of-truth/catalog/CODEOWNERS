# One owner per domain path. Additive changes inside a domain path auto-merge once CODEOWNERS approve (ADR-017).
# Shared root schemas and the central bus belong to the platform team; no domain may own them.

/domains/orders/                 @example/orders-team
/services/order-service/         @example/orders-team
/events/OrderPlaced/             @example/orders-team
/events/order.aggregate.updated/ @example/orders-team
/commands/PlaceOrder/            @example/orders-team
/queries/GetOrder/               @example/orders-team
/channels/orders-bus.*/          @example/orders-team
/channels/orders-sub.*/          @example/orders-team
/channels/orders-api/            @example/orders-team
/data-products/orders-events-silver/   @example/orders-team
/schemas/orders/                 @example/orders-team

/domains/payments/               @example/payments-team
/services/payment-service/       @example/payments-team
/events/PaymentCaptured/         @example/payments-team
/channels/payments-bus.*/        @example/payments-team
/channels/payments-sub.*/        @example/payments-team
/data-products/payments-events-silver/ @example/payments-team

/schemas/*.json                  @example/platform-team
/channels/central-bus.*/         @example/platform-team
/teams/                          @example/platform-team
/eventcatalog.config.js          @example/platform-team
/CODEOWNERS                      @example/platform-team
